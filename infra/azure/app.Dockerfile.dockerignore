# Build from the repository root with infra/azure/app.Dockerfile.
# Allowlist: only the files the running app needs enter the build context.
**

# Frontend served on the same origin (see backend/main.py)
!index.html
!src/
!src/**
!assets/
!assets/**

# Backend: app code, Ranked bank data, migrations
!backend/
!backend/**

# Never in the image, even if present locally (audit L4). `COPY backend`
# takes the whole directory, so anything not excluded here ships.
backend/tests
backend/tests/**
# The development manifest. The image installs requirements-runtime.txt and
# has no use for this one; shipped, it is a printed list of every package
# and version the project uses, handed to anyone who pulls the image.
backend/requirements.txt
backend/.venv
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.key
**/*.pem
